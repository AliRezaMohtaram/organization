@model OrgChart.Razor.Admin.Pages.Positions.MoveModel
@{
    string cancel = Model.UnitUrl(Model.Position.UnitKey, IndexModel.TabPositions);
}
<form class="modal modal-sm" method="post" asp-area="OrgChart" asp-page="/Positions/Move" asp-route-key="@Model.Position.Key" data-mx-ajax novalidate>
    <div class="modal-head">
        <span class="modal-head-ico"><svg class="ico"><use href="#oc-move" /></svg></span>
        <div>
            <div class="modal-title">@OrgText.Format("Position_MoveHeading", Model.Position.Title)</div>
            <div class="modal-sub">@OrgText.Get("Position_MoveHint")</div>
        </div>
        <a class="icon-btn plain close" href="@cancel" data-close aria-label="@OrgText.Get("Close")"><svg class="ico"><use href="#oc-x" /></svg></a>
    </div>
    <div class="modal-body">
        <partial name="/Areas/OrgChart/Pages/Shared/_FormErrors.cshtml" />
        <div class="field">
            <label class="label" for="UnitKey">@OrgText.Get("Field_NewUnit")</label>
            <select class="select" asp-for="UnitKey" asp-items="OrgOptions.Units(Model.Chart, Model.UnitKey)" autofocus></select>
        </div>
    </div>
    <div class="modal-foot">
        <span class="spacer"></span>
        <a class="btn btn-quiet" href="@cancel" data-close>@OrgText.Get("Cancel")</a>
        <button type="submit" class="btn btn-primary"><svg class="ico"><use href="#oc-move" /></svg>@OrgText.Get("Position_Move")</button>
    </div>
</form>
