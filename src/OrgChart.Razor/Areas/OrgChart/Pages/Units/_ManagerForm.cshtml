@model OrgChart.Razor.Admin.Pages.Units.ManagerModel
@{
    string cancel = Model.UnitUrl(Model.Unit.Key);
    List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> positions = OrgOptions.Positions(Model.Chart, Model.PositionKey, onlyUnit: Model.Unit.Key);
}
<form class="modal modal-sm" method="post" asp-area="OrgChart" asp-page="/Units/Manager" asp-route-key="@Model.Unit.Key" data-mx-ajax novalidate>
    <div class="modal-head">
        <span class="modal-head-ico"><svg class="ico"><use href="#oc-star" /></svg></span>
        <div>
            <div class="modal-title">@OrgText.Format("Unit_ManagerHeading", Model.Unit.Title)</div>
            <div class="modal-sub">@OrgText.Get("Unit_ManagerHint")</div>
        </div>
        <a class="icon-btn plain close" href="@cancel" data-close aria-label="@OrgText.Get("Close")"><svg class="ico"><use href="#oc-x" /></svg></a>
    </div>
    <div class="modal-body">
        <partial name="/Areas/OrgChart/Pages/Shared/_FormErrors.cshtml" />
        @if (positions.Count == 0)
        {
            <div class="callout"><svg class="ico"><use href="#oc-info" /></svg><div>@OrgText.Get("Unit_ManagerNoPositions")</div></div>
        }
        else
        {
            <div class="field">
                <label class="label" for="PositionKey">@OrgText.Get("Field_ManagerPosition")</label>
                <select class="select" asp-for="PositionKey" asp-items="positions" autofocus>
                    <option value="">@OrgText.Get("Unit_NoManager")</option>
                </select>
            </div>
        }
    </div>
    <div class="modal-foot">
        <span class="spacer"></span>
        <a class="btn btn-quiet" href="@cancel" data-close>@OrgText.Get("Cancel")</a>
        @if (positions.Count > 0)
        {
            <button type="submit" class="btn btn-primary"><svg class="ico"><use href="#oc-check" /></svg>@OrgText.Get("Save")</button>
        }
    </div>
</form>
