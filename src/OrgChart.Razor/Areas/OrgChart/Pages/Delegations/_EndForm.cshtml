@model OrgChart.Razor.Admin.Pages.Delegations.EndModel
<form class="modal modal-sm" method="post" asp-area="OrgChart" asp-page="/Delegations/End" asp-route-id="@Model.Id" asp-route-mode="@Model.Mode" data-mx-ajax novalidate>
    <div class="modal-head">
        <span class="modal-head-ico @(Model.IsRemove ? "tone-danger" : "tone-warning")"><svg class="ico"><use href="#@(Model.IsRemove ? "oc-trash" : "oc-end")" /></svg></span>
        <div><div class="modal-title">@OrgText.Get(Model.IsRemove ? "Delegation_Remove" : "Delegation_End")</div></div>
        <a class="icon-btn plain close" href="@Model.BackUrl" data-close aria-label="@OrgText.Get("Close")"><svg class="ico"><use href="#oc-x" /></svg></a>
    </div>
    <div class="modal-body">
        <partial name="/Areas/OrgChart/Pages/Shared/_FormErrors.cshtml" />
        <p class="oc-confirm-text">@Model.Summary<br /><span class="cell-sub">@Model.Dates.Period(Model.Delegation.ValidFrom, Model.Delegation.ValidTo)</span></p>
        @if (Model.IsRemove)
        {
            <div class="callout tone-warning" style="margin-top:1rem"><svg class="ico"><use href="#oc-alert" /></svg><div>@OrgText.Get("Delegation_RemoveText")</div></div>
        }
        else
        {
            <div class="field" style="margin-top:1rem">
                <div class="seg oc-radio-seg" role="radiogroup" aria-label="@OrgText.Get("Field_EndWhen")">
                    <label><input type="radio" name="When" value="now" checked="@(Model.When != "date")" /><span>@OrgText.Get("End_Now")</span></label>
                    <label><input type="radio" name="When" value="date" checked="@(Model.When == "date")" /><span>@OrgText.Get("End_OnDate")</span></label>
                </div>
            </div>
            <div class="field" style="margin-top:.75rem">
                <label class="label" for="LastDay">@OrgText.Get("Field_LastDay")</label>
                <input class="input ltr" id="LastDay" name="LastDay" value="@Model.LastDay" autocomplete="off" placeholder="1405/07/30" inputmode="numeric" />
            </div>
        }
    </div>
    <div class="modal-foot">
        <span class="spacer"></span>
        <a class="btn btn-quiet" href="@Model.BackUrl" data-close>@OrgText.Get("Cancel")</a>
        <button type="submit" class="btn @(Model.IsRemove ? "btn-danger" : "btn-primary")" autofocus><svg class="ico"><use href="#@(Model.IsRemove ? "oc-trash" : "oc-end")" /></svg>@OrgText.Get(Model.IsRemove ? "Delegation_Remove" : "Delegation_End")</button>
    </div>
</form>
