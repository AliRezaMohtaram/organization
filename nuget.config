<?xml version="1.0" encoding="utf-8"?>
<!--
  Acl packages come from the Acl clone next to this repository (../Acl, after `dotnet pack Acl.sln -c Release`)
  until they are on a shared feed. Source mapping pins Acl.* to that folder: nuget.org has unrelated packages with the
  same names (e.g. "Acl.Core" 3.x), which must never be picked up. If your Acl clone is elsewhere, change the path here.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="acl-local" value="../Acl/artifacts/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="acl-local">
      <package pattern="Acl.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
