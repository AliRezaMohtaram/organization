<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <!-- NuGet package metadata, shared by the packages under src/. -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <Authors>Alireza</Authors>
    <Copyright>Copyright © Alireza $([System.DateTime]::UtcNow.Year)</Copyright>
    <Description>Reusable organizational chart module for ASP.NET Core: org units, positions and assignments with stable keys.</Description>
    <PackageTags>org-chart;organization;aspnetcore;efcore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
